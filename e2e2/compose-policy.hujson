{
  "tagOwners": {
    "tag:client": ["e2e@example.com"],
    "tag:denied": ["e2e@example.com"],
    "tag:dns": ["e2e@example.com"],
    "tag:gateway1": ["e2e@example.com"]
  },
  "grants": [
    {"src": ["*"], "dst": ["tag:dns"], "ip": ["udp:53"]},
    {"src": ["tag:client"], "dst": ["tag:dns", "tag:gateway1"], "app": {"matchlighter.net/domain-gateway": [{"range": ["10.254.0.0/18"], "upstreamDNS": "172.30.0.10:5353", "resources": [{"domain": "protected.example.test", "ip": ["tcp:80", "tcp:443", "udp:9000"]}]}]}},
    {"src": ["tag:client"], "dst": ["10.254.0.0/18"], "ip": ["tcp:80", "tcp:443", "udp:9000"], "via": ["tag:gateway1"]}
  ],
  "autoApprovers": {"routes": {"10.254.0.0/18": ["tag:gateway1"]}},
  "nodeAttrs": [{"target": ["tag:dns"], "app": {"matchlighter.net/domain-gateway": [{"upstreamDNS": "172.30.0.10:5353"}]}}]
}
